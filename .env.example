# ── LLM provider ────────────────────────────────────────────────────────────────
# Which provider get_model() uses by default: groq | ollama
LLM_PROVIDER=ollama

# ── Groq (LLM) ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_MODEL=openai/gpt-oss-120b
GROQ_STRUCTURED_METHOD=function_calling
GROQ_TEMPERATURE=0.3
GROQ_TIMEOUT=60
GROQ_MAX_TOKENS=4096
GROQ_MAX_RETRIES=5

# ── Ollama (LLM, cloud) ─────────────────────────────────────────────────────────
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_BASE_URL=https://ollama.com

# ── Kaggle ──────────────────────────────────────────────────────────────────────
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=

# ── Qdrant ──────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# Optional for authenticated Qdrant
QDRANT_API_KEY=

# ── Embeddings ──────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024

# ── Tavily web search ───────────────────────────────────────────────────────────
TAVILY_API_KEY=

